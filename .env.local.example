# このファイルを .env.local という名前でコピーして、実際の値を入れてください。
# .env.local はGitにコミットされません（.gitignoreに設定済み）。

# Supabaseダッシュボード > Project Settings > API で確認できます
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# 同じ画面の「service_role」キー（秘密情報。絶対に公開しない・ブラウザに出さない）
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# このサイト自身の公開URL（sitemap.xml・canonical URLに使用）
# 独自ドメイン設定前は、Vercelが発行したURL（例：https://car-wes-results.vercel.app）を入れておいてください
NEXT_PUBLIC_SITE_URL=https://results.ka-wes.com
